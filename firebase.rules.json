{
  "rules": {
    ".read": false,
    ".write": false,

    "leaderboard": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'bestScore', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "bestScore": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": { ".validate": false }
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",

        "seed": {
          ".validate": "newData.isNumber()"
        },
        "duration": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 300"
        },
        "startAt": {
          ".validate": "newData.val() === null || newData.val() === now"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'score', 'wordsFormed'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() - data.val() <= 200)"
            },
            "wordsFormed": {
              ".validate": "newData.hasChildren() || !newData.exists()",
              "$index": {
                ".validate": "newData.isString() && newData.val().length <= 8"
              }
            },
            "$other": { ".validate": false }
          }
        },

        "takenLetters": {
          "$letterId": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          }
        },

        "$other": { ".validate": false }
      }
    },

    "wordCandidates": {
      "$word": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['count', 'firstSeenAt'])",
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "firstSeenAt": {
          ".validate": true
        },
        "$other": { ".validate": false }
      }
    }
  }
}
