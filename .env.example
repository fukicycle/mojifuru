# Firebase設定(RTDB + Anonymous Auth)。
# Firebaseコンソールでプロジェクトを作成し、Authentication > Sign-in method で
# 「匿名」を有効化した上で、以下の値を .env.local にコピーして設定すること。
# 未設定のままでも「ひとりで遊ぶ」モードは動作する(対戦モード・ランキングのみ無効化される)。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
